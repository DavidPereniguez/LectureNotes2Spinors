Cell[TextData[{
 "We have found that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptL]", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7e02e0a9-4bdf-44f3-92e4-b3f9e98ca37e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptN]", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "745875ea-a65f-439c-8a3a-a1bfc0dd35a4"],
 " are geodesic and shearfree. Then, by the Goldberg--Sachs theorem they must \
be aligned with repeated PNDs and the space must be type D. We can confirm \
this below by computing the Weyl scalars."
}], "Text",
 CellChangeTimes->{{3.953700894732695*^9, 
  3.953700954474814*^9}},ExpressionUUID->"c1523ed3-44c5-4c4e-b420-\
25f9b0c61bf5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"\[Tau]p", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "-", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"r", "+", 
       RowBox[{"I", " ", "a", " ", "x", " "}]}], 
      RowBox[{"r", "-", 
       RowBox[{"I", " ", "a", " ", "x"}]}]], 
     RowBox[{"\[Tau]", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"\[Rho]p", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}], " "}], 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", 
            RowBox[{"2", " "}]], 
           SuperscriptBox["x", "2"]}]}], ")"}]}]]}], 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.953904789480908*^9, 3.953904897698948*^9}},
 CellLabel->
  "In[272]:=",ExpressionUUID->"85c956a0-6978-4111-8829-e963868fa0c9"],

