Cell[CellGroupData[{

Cell["2.2. Weyl Scalars", "Subsection",
 CellChangeTimes->{{3.953700968024108*^9, 
  3.953700970662262*^9}},ExpressionUUID->"340739c7-9b13-4930-8cd5-\
dac24896c5cb"],

Cell["\<\
Since the spacetime is Ricci-flat, we do not need to compute the Weyl scalar \
since it coincides with the Riemann. First we compute the Riemann with all \
indices down:\
\>", "Text",
 CellChangeTimes->{{3.953700992652273*^9, 3.953701014260051*^9}, {
  3.953701078037511*^9, 
  3.953701087099525*^9}},ExpressionUUID->"6eef851b-197e-4c7c-af3b-\
f34905a87a3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Rie", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"lower", "[", 
       RowBox[{"Riemann", ",", 
        RowBox[{"{", "4", "}"}]}], "]"}], "/.", "OnShell$\[CapitalSigma]"}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "compute", " ", "the", " ", "Riemann", " ", "with", " ", "all", 
    " ", "indices", " ", "down"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.925883087714664*^9, 3.925883100300054*^9}, {
  3.947910386446393*^9, 3.9479104101176157`*^9}, {3.948278722281499*^9, 
  3.948278733068478*^9}, {3.953697851533125*^9, 3.953697884417272*^9}, {
  3.953701028430706*^9, 3.9537010553471212`*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"0d042cc9-4a9a-469d-841c-880616ccf744"],

Cell["\<\
Next we apply the definition of the Weyl scalars (see e.g. Newman--Penrose \
(1962) or Chandrasekar (1983)):\
\>", "Text",
 CellChangeTimes->{{3.953701094405684*^9, 
  3.95370112725364*^9}},ExpressionUUID->"246e2beb-4937-4ee5-acb8-\
64926d5d3eee"],

