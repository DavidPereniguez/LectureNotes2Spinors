Cell["\<\
For example, we can check that the metric above on shell satisfies the \
Einstein equations:\
\>", "Text",
 CellChangeTimes->{{3.953699934363924*^9, 
  3.953699958395483*^9}},ExpressionUUID->"0f57c72c-a2ca-4050-9dc5-\
9defb62f2e8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Einstein", "/.", "OnShell"}], ")"}], "==", "0"}], "]"}]], "Input",\

 CellLabel->"In[11]:=",ExpressionUUID->"d76cabc6-5398-4116-82cf-e77294de69a3"],

