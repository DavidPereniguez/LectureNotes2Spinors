Cell["\<\
Next we introduce the following Kinnersley null tetrad (a tetrad that as we \
will show next is aligned with the repeated PNDs of Kerr):\
\>", "Text",
 CellChangeTimes->{{3.953699976612061*^9, 
  3.953700006010474*^9}},ExpressionUUID->"4824879a-5111-472c-baca-\
37d43bf45fe6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptL]UP", "=", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["a", "2"], "+", 
         SuperscriptBox["r", "2"]}], ")"}], 
       RowBox[{"\[CapitalDelta]", "[", "r", "]"}]], ",", "1", ",", "0", ",", 
      FractionBox["a", 
       RowBox[{"\[CapitalDelta]", "[", "r", "]"}]]}], "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"outoing", " ", "repeated", " ", "PND"}], ",", " ", 
    RowBox[{"with", " ", "index", " ", "up"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptN]UP", "=", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["a", "2"], "+", 
         SuperscriptBox["r", "2"]}], ")"}], 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["x", "2"]}]}], ")"}]}]], ",", 
      FractionBox[
       RowBox[{"-", 
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["x", "2"]}]}], ")"}]}]], ",", "0", ",", 
      FractionBox["a", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["x", "2"]}]}], ")"}]}]]}], "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ingoing", " ", "repeated", " ", "PND"}], ",", " ", 
    RowBox[{"with", " ", "index", " ", "up"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptM]UP", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SqrtBox["2"], 
       RowBox[{"(", 
        RowBox[{"r", "+", 
         RowBox[{"I", " ", "a", " ", "x"}]}], ")"}]}]], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"I", " ", "a", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}], ",", "0", ",", 
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}], ",", 
       FractionBox["I", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]]}], "}"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"index", " ", "up"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptM]CUP", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SqrtBox["2"], 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         RowBox[{"I", " ", "a", " ", "x"}]}], ")"}]}]], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "I"}], " ", "a", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}], ",", "0", ",", 
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}], ",", 
       RowBox[{"-", 
        FractionBox["I", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]]]}]}], "}"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "up"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptL]", "=", 
    RowBox[{"lower", "[", "\[ScriptL]UP", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"index", " ", "down"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptN]", "=", 
    RowBox[{"lower", "[", "\[ScriptN]UP", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "down"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptM]", "=", 
    RowBox[{"lower", "[", "\[ScriptM]UP", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "down"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptM]C", "=", 
    RowBox[{"lower", "[", "\[ScriptM]CUP", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "down"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.953700018548588*^9, 3.953700069797533*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"2dd4e22e-1d0c-4281-8671-6933dbbaf4ea"],

Cell["\<\
We can check they satisfy the null-frame orthogonality relations:\
\>", "Text",
 CellChangeTimes->{{3.953700077599712*^9, 
  3.953700093463091*^9}},ExpressionUUID->"8f962db0-8b48-4f8a-858d-\
6d6d9b43c631"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"contract", "[", 
      RowBox[{"\[ScriptL]", "**", "\[ScriptL]"}], "]"}], "/.", "OnShell"}], 
    ")"}], "==", "0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"contract", "[", 
      RowBox[{"\[ScriptN]", "**", "\[ScriptN]"}], "]"}], "/.", "OnShell"}], 
    ")"}], "==", "0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"contract", "[", 
      RowBox[{"\[ScriptM]", "**", "\[ScriptM]"}], "]"}], "/.", "OnShell"}], 
    ")"}], "==", "0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"contract", "[", 
      RowBox[{"\[ScriptM]C", "**", "\[ScriptM]C"}], "]"}], "/.", "OnShell"}], 
    ")"}], "==", "0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
