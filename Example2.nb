        "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"l", "-", "2"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"l", "+", "2", "+", "1"}], ")"}], 
    RowBox[{"S", "[", "x", "]"}], 
