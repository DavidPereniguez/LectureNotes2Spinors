         RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "\[Element]", 
           "Reals"}], ",", 
          RowBox[{"a", "\[Element]", "Reals"}], ",", 
          RowBox[{"r", "\[Element]", "Reals"}], ",", 
          RowBox[{"x", "\[Element]", "Reals"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"-", "1"}], ",", "3"}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<\[Rho]\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]", "=", 
  RowBox[{"{", 
