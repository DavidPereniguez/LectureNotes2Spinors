Cell[TextData[{
 "We can also check that both ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptL]", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "def6e394-628f-4954-a7c5-2b663a8a8f78"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptN]", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e566dfa5-293b-4084-8a2c-9f54fec6c170"],
 " are geodesic, although only ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d9baf64-6bcd-4a3f-ae9f-083949b640ec"],
 " is affinely parametrised (with a GHP transformation one can make ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptN]", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3671107c-fa04-4b2c-894d-e8d129669f89"],
 " affinely parametrised instead):"
}], "Text",
 CellChangeTimes->{{3.953700118249649*^9, 
  3.953700175247354*^9}},ExpressionUUID->"8bd61d20-4a1d-4c90-a925-\
5670fc7356fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"contract", "[", 
   RowBox[{
    RowBox[{"\[ScriptL]", "**", 
     RowBox[{"covariant", "[", "\[ScriptL]", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "/.", 
  "OnShell"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"contract", "[", 
      RowBox[{
       RowBox[{"\[ScriptN]", "**", 
        RowBox[{"covariant", "[", "\[ScriptN]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "M"}], " ", 
          SuperscriptBox["r", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"r", "+", 
            RowBox[{"M", " ", 
             SuperscriptBox["x", "2"]}], "-", 
            RowBox[{"r", " ", 
             SuperscriptBox["x", "2"]}]}], ")"}]}]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["x", "2"]}]}], ")"}], "2"]], ")"}], 
      "\[ScriptN]"}]}], ")"}], "/.", "OnShell"}], "//", 
  "Simplify"}]}], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"14d19860-551a-4a16-b1b1-89ebd826c507"],

Cell[BoxData[
 RowBox[{"{", 
