Cell[TextData[{
 "It is useful to define some functions that evaluate the metric on-shell, \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "[", "r", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "367b209c-c4f6-4527-9f35-07ae66db55ad"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"r", ",", "x"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "85e83666-a021-49f8-b05e-cd69ab0f2e75"],
 " are given by:"
}], "Text",
 CellChangeTimes->{{3.953699897466655*^9, 
  3.953699927816887*^9}},ExpressionUUID->"84a7f0f3-aabf-4bbd-9997-\
5a42acd13384"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"OnShell", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[CapitalSigma]", "->", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "x"}], "}"}], ",", 
       RowBox[{
        SuperscriptBox["r", "2"], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["x", "2"]}]}]}], "]"}]}], ",", 
    RowBox[{"\[CapitalDelta]", "->", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", 
       RowBox[{
        SuperscriptBox["r", "2"], "+", 
        SuperscriptBox["a", "2"], "-", 
        RowBox[{"2", "M", "  ", "r"}]}]}], "]"}]}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"OnShell$\[CapitalSigma]", "=", 
  RowBox[{"{", 
   RowBox[{"\[CapitalSigma]", "->", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "x"}], "}"}], ",", 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["x", "2"]}]}]}], "]"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"OnShell$\[CapitalDelta]", "=", 
  RowBox[{"{", 
   RowBox[{"\[CapitalDelta]", "->", " ", 
    RowBox[{"Function", "[", 
     RowBox[{"r", ",", 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       SuperscriptBox["a", "2"], "-", 
       RowBox[{"2", "M", "  ", "r"}]}]}], "]"}]}], 
   "}"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.885984125650531*^9, 3.885984189581184*^9}, {
