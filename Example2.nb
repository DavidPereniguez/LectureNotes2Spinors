Cell[CellGroupData[{

Cell["2. The GHP Quantities", "Section",
 CellChangeTimes->{{3.9537002032012663`*^9, 
  3.9537002115463877`*^9}},ExpressionUUID->"46756793-9493-4fc2-822e-\
b604065bee30"],

Cell[TextData[{
 "We will obtain the GHP quantities leaving the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "[", "r", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8ba8b39-7b8e-4b76-a310-4eee600277bb"],
 " arbitrary, while we will be specifying ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"r", ",", "x"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d817bc9-ca0d-4b09-b217-37d74d3a8f62"],
 " to its value on shell."
}], "Text",
 CellChangeTimes->{{3.953700247925337*^9, 
  3.953700286686097*^9}},ExpressionUUID->"dd5e138a-9730-4804-afc2-\
3bed32502aa2"],

Cell[CellGroupData[{

Cell["2.1. Spin Coefficients", "Subsection",
 CellChangeTimes->{{3.9537002185892763`*^9, 
  3.953700222939934*^9}},ExpressionUUID->"0b28161a-e673-4621-b8c8-\
426c1c32d5b6"],

Cell["\<\
We first compute the covariant derivatives of the frame (everything with \
indices down):\
\>", "Text",
 CellChangeTimes->{{3.953700228816183*^9, 3.953700237603389*^9}, {
  3.9537002905517673`*^9, 
  3.953700322016778*^9}},ExpressionUUID->"eaa53b9a-75df-4233-be4d-\
a360991d1289"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Cov\[ScriptL]", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"covariant", "[", "\[ScriptL]", "]"}], "/.", 
     "OnShell$\[CapitalSigma]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Cov\[ScriptN]", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"covariant", "[", "\[ScriptN]", "]"}], "/.", 
     "OnShell$\[CapitalSigma]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Cov\[ScriptM]", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"covariant", "[", "\[ScriptM]", "]"}], "/.", 
     "OnShell$\[CapitalSigma]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Cov\[ScriptM]C", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"covariant", "[", "\[ScriptM]C", "]"}], "/.", 
     "OnShell$\[CapitalSigma]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.953700333604142*^9, 3.953700339290148*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"aa418db0-0e44-46d7-82db-4402543e9f7a"],

Cell["\<\
Next we compute the spin coefficients following their definition given in \
Geroch-Held-Penrose (1973) in terms of the null frame. We will also keep \
track of their weights. For the properly-weighted coefficients we have:\
\>", "Text",
 CellChangeTimes->{{3.953700362578436*^9, 
  3.953700442510743*^9}},ExpressionUUID->"e2940608-5c99-4a48-86ee-\
f03e4cb807af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<\[Kappa]\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Kappa]", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cov\[ScriptL]", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], 
        RowBox[{"\[ScriptL]UP", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        RowBox[{"\[ScriptM]UP", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}], ",", "3", 
    ",", "1"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<\!\(\*OverscriptBox[\(\[Kappa]\), \(_\)]\)\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Kappa]C", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"\[Kappa]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "\[Element]", 
           "Reals"}], ",", 
          RowBox[{"a", "\[Element]", "Reals"}], ",", 
          RowBox[{"r", "\[Element]", "Reals"}], ",", 
          RowBox[{"x", "\[Element]", "Reals"}]}], "}"}]}]}], "]"}], ",", "1", 
     ",", "3"}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<\[Sigma]\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Sigma]", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cov\[ScriptL]", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], 
        RowBox[{"\[ScriptM]UP", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        RowBox[{"\[ScriptM]UP", "[", 
