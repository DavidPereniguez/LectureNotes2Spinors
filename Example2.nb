Cell[CellGroupData[{

Cell["3.2. Spin-weighted Spherical Harmonics", "Subsection",
 CellChangeTimes->{{3.953718730721977*^9, 
  3.953718747059787*^9}},ExpressionUUID->"89de3df3-5db8-4139-92c3-\
610bb75c0a0d"],

Cell["Introducing them as sections of a line-bundle on the sphere:", "Text",
 CellChangeTimes->{{3.953718764117815*^9, 
  3.9537187991764393`*^9}},ExpressionUUID->"98195880-6b89-4c9d-8828-\
ad5be3385115"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eth]S", "[", "f_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       SuperscriptBox[
        RowBox[{"(", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]], ")"}], 
        RowBox[{"f", "[", 
         RowBox[{"[", "2", "]"}], "]"}]], ")"}]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]]}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"]}]], ")"}], 
            RowBox[{"-", 
             RowBox[{"f", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]], 
           RowBox[{"f", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "x"}], "]"}]}], "+", 
       RowBox[{
        FractionBox["I", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]]], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"]}]], ")"}], 
            RowBox[{"-", 
             RowBox[{"f", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]], 
           RowBox[{"f", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[Chi]"}], "]"}]}]}], 
      ")"}]}], ",", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "+", "1"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eth]SC", "[", "f_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       SuperscriptBox[
        RowBox[{"(", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]], ")"}], 
        RowBox[{"-", 
         RowBox[{"f", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]], ")"}]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]]}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"]}]], ")"}], 
            RowBox[{"f", "[", 
             RowBox[{"[", "2", "]"}], "]"}]], 
           RowBox[{"f", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "x"}], "]"}]}], "-", 
       RowBox[{
        FractionBox["I", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}]]], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"]}]], ")"}], 
            RowBox[{"f", "[", 
             RowBox[{"[", "2", "]"}], "]"}]], 
           RowBox[{"f", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[Chi]"}], "]"}]}]}], 
      ")"}]}], ",", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalY]", "[", 
   RowBox[{"s_", ",", "l_", ",", "m_", ",", "x_", ",", "\[Chi]_"}], "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"s", ">=", "0"}], ",", 
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"Factorial", "[", 
         RowBox[{"l", "-", "s"}], "]"}], 
        RowBox[{"Factorial", "[", 
         RowBox[{"l", "+", "s"}], "]"}]]], 
      RowBox[{
       RowBox[{"Nest", "[", 
        RowBox[{"\[Eth]S", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"l", ",", "m", ",", 
             RowBox[{"ArcCos", "[", "x", "]"}], ",", "\[Chi]"}], "]"}], ",", 
           "0"}], "}"}], ",", "s"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "s"], 
      SqrtBox[
       FractionBox[
        RowBox[{"Factorial", "[", 
         RowBox[{"l", "+", "s"}], "]"}], 
        RowBox[{"Factorial", "[", 
         RowBox[{"l", "-", "s"}], "]"}]]], 
      RowBox[{
       RowBox[{"Nest", "[", 
        RowBox[{"\[Eth]SC", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"l", ",", "m", ",", 
             RowBox[{"ArcCos", "[", "x", "]"}], ",", "\[Chi]"}], "]"}], ",", 
           "0"}], "}"}], ",", 
         RowBox[{"-", "s"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalY]C", "[", 
   RowBox[{"s_", ",", "l_", ",", "m_", ",", "x_", ",", "\[Chi]_"}], "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Conjugate", "[", 
     RowBox[{"\[ScriptCapitalY]", "[", 
      RowBox[{"s", " ", ",", "l", ",", "m", ",", "x", ",", "\[Chi]"}], "]"}], 
     "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "\[Element]", "Reals"}], ",", 
       RowBox[{"\[Chi]", "\[Element]", "Reals"}], ",", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", " ", 
          SuperscriptBox["x", "2"]}]], "\[Element]", "Reals"}], ",", 
       RowBox[{
        FractionBox["1", 
         SqrtBox[
          RowBox[{"2", "-", " ", 
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}]}]]], "\[Element]", "Reals"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[175]:=",ExpressionUUID->"e5902cdd-4c3e-4968-b5dc-f6f376b69e2c"],

Cell["\<\
The replacement rule for its second derivative is (see derivation below):\
\>", "Text",
 CellChangeTimes->{{3.953719113048287*^9, 
  3.953719128869937*^9}},ExpressionUUID->"2a1b860d-7919-4eb7-b802-\
046c7ed5ed58"],

Cell[BoxData[
 RowBox[{"Harm$Rep$Rupe", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SuperscriptBox["S", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "x", "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "+", 
         SuperscriptBox["m", "2"], "+", 
         RowBox[{"4", " ", "m", " ", "x"}], "+", 
         RowBox[{"l", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["x", "2"]}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["l", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["x", "2"]}], ")"}]}]}], ")"}], " ", 
       RowBox[{"S", "[", "x", "]"}]}], "-", 
      RowBox[{"2", " ", "x", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["x", "2"]}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["S", "\[Prime]",
         MultilineFunction->None], "[", "x", "]"}]}]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["x", "2"]}], ")"}], "2"]]}], "}"}]}]], "Input",Expressi\
onUUID->"e26bb985-ee7d-43ff-a9a9-42510788b321"],

Cell[CellGroupData[{

Cell["\<\
3.2.1. Deriving a replacement rule for the spin-weighted spherical harmonics\
\>", "Subsubsection",
 CellChangeTimes->{{3.9537188733769197`*^9, 
  3.953718886726869*^9}},ExpressionUUID->"5fd2f496-733c-468a-b806-\
d1d2bcbd08cc"],

Cell["Consider the sphere:", "Text",
 CellChangeTimes->{{3.9537189864476633`*^9, 
  3.953718998349831*^9}},ExpressionUUID->"1dd6f875-0064-422c-8c78-\
97d5189f9497"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coord", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "\[Chi]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", " ", 
   RowBox[{"And", "[", 
    RowBox[{
     RowBox[{"x", "\[Element]", "Reals"}], ",", 
     RowBox[{"\[Chi]", "\[Element]", "Reals"}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "<", "x", "<", "1"}], ",", 
     RowBox[{"0", "<", "\[Chi]", "<", 
      RowBox[{"2", "\[Pi]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metric", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], ",", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]}], "}"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"3e861bea-88e6-44fe-8e36-42e9c2ae85e5"],

Cell[TextData[{
 "We write the harmonic equation satisfied by spin-weighted spherical \
harmonics using an ansatz ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalY]", "=", 
    RowBox[{
     RowBox[{"S", "[", "x", "]"}], 
     SuperscriptBox["e", 
      RowBox[{"i", " ", "m", " ", "\[Chi]"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c90d5d8c-e971-4551-ae7a-3d3858fed0a3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.953719005288209*^9, 
  3.9537190468076563`*^9}},ExpressionUUID->"580dbd4b-3867-4d7e-9896-\
be88f9d71f23"],

