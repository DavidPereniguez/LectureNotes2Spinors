        RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}], ",", "3", 
    ",", 
    RowBox[{"-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<\!\(\*OverscriptBox[\(\[Sigma]\), \(_\)]\)\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]C", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", 
