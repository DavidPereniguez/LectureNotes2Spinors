Cell[TextData[{
 StyleBox["Description:",
  FontWeight->"Bold"],
 " Example notebook associated to the notes [XXXX] on 2-spinors in GR. We \
derive non-perturbative curavture equations for the Weyl scalars, starting \
from the spinor equations. Then we derive the Teukolsky equations and their \
sources.\n",
 StyleBox["Author: ",
  FontWeight->"Bold"],
 "David Pere\[NTilde]iguez, ",
 StyleBox["dpereni1@jhu.edu",
  FontFamily->"Courier New",
  FontWeight->"Regular"],
 StyleBox["\nWeb: ",
  FontWeight->"Bold"],
 "\nThis code makes use of the mathematica package ",
 StyleBox["diffgeo ",
  FontSlant->"Italic"],
 "(download here https://github.com/bryango/diffgeoM ) as well as several ",
 StyleBox["xAct ",
  FontSlant->"Italic"],
 "mathematica packages (download here  https://josmar493.dreamhosters.com/ ). "
}], "Text",
 CellChangeTimes->{{3.9536997274814243`*^9, 3.953699839202078*^9}, {
   3.9537207716731567`*^9, 3.953720817691307*^9}, {3.9537208640254087`*^9, 
