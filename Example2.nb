     SubscriptBox["\[CapitalPsi]", "2"], "=", 
     RowBox[{
      SubscriptBox["\[CapitalPsi]", "3"], "=", 
      RowBox[{
       SubscriptBox["\[CapitalPsi]", "4"], "=", "0"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99bc586b-cbaa-4fc8-bfcd-4c0adc8ccd50"],
