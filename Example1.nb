Cell[TextData[{
 "We trade primed derivatives of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", "0"], TraditionalForm]],ExpressionUUID->
  "40599ef3-f11c-464c-9048-7db3220ef6c8"],
 " by first derivatives of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", "1"], TraditionalForm]],ExpressionUUID->
  "2ce55b76-681a-4af6-bbc4-5964847235fe"],
 " (we do so because primed derivatives of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", "0"], TraditionalForm]],ExpressionUUID->
  "397b277a-a846-4825-8417-bf5fd92d1a75"],
 " appear multiplied by spin coefs that are nontrivial in type-D backgrounds, \
so we avoid having terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"~", "\[Thorn]"}], "'"}], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "."], "0"]}], TraditionalForm]],
  ExpressionUUID->"88a879b1-6449-4f42-93f3-4685d4a7e6aa"],
 ", etc in the linearisation). We eliminate derivatives of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", ",", 
    RowBox[{"\[Rho]", "'"}], ",", "\[Tau]", ",", 
    RowBox[{"\[Tau]", "'"}], ",", 
    SubscriptBox["\[CapitalPsi]", "2"]}], TraditionalForm]],ExpressionUUID->
  "86cbcacd-e2f4-4f9f-a957-b99f40441b02"],
 " (to avoid having dotted GHP derivatives in the linearisation):"
}], "Text",
 CellChangeTimes->{
  3.979981753885633*^9},ExpressionUUID->"907fe3bb-379c-462a-9c26-\
acd6c13836db"],

Cell[CellGroupData[{

