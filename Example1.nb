Cell[TextData[{
 "A 2nd-order curvature equation follows by just hitting the first-order one \
with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[EmptyDownTriangle]", "A"], 
    RowBox[{"A", "'"}]], TraditionalForm]],ExpressionUUID->
  "49ef78ce-f186-40c8-9d22-8ca81ab663c3"],
 ", although that will not be written in terms of its irreducible \
components:"
}], "Text",
