\[Rho]Dyad[]*
  \[Sigma]Dyad[] + 8*PsiCDe0Dyad[]*\[Sigma]Dyad[]*\[Sigma]pDyad[] - 
 24*PsiCDe2Dyad[]*\[Kappa]Dyad[]*\[Tau]Dyad[] + 8*PsiCDe1Dyad[]*\[Sigma]Dyad[]*
  \[Tau]Dyad\[Dagger][] - 16*PsiCDe1Dyad[]*\[Sigma]Dyad[]*\[Tau]pDyad[] - 
 2*\[Rho]pDyad\[Dagger][]*\[CapitalTheta]Dyad[{1, -NP}][PsiCDe0Dyad[]] - 
 8*\[Sigma]Dyad[]*\[CapitalTheta]Dyad[{1, -NP}][PsiCDe2Dyad[]] - 
 10*\[Rho]Dyad[]*\[CapitalTheta]Dyad[{2, -NP}][PsiCDe0Dyad[]] + 
 8*PsiCDe1Dyad[]*\[CapitalTheta]Dyad[{2, -NP}][\[Kappa]Dyad[]] + 
 2*\[CapitalTheta]Dyad[{2, -NP}][\[CapitalTheta]Dyad[{1, \
-NP}][PsiCDe0Dyad[]]] + 
 2*\[Tau]Dyad\[Dagger][]*\[CapitalTheta]Dyad[{3, -NP}][PsiCDe0Dyad[]] + 
 8*\[Kappa]Dyad[]*\[CapitalTheta]Dyad[{3, -NP}][PsiCDe2Dyad[]] + 
 10*\[Tau]Dyad[]*\[CapitalTheta]Dyad[{4, -NP}][PsiCDe0Dyad[]] - 
 8*PsiCDe1Dyad[]*\[CapitalTheta]Dyad[{4, -NP}][\[Sigma]Dyad[]] - 
 2*\[CapitalTheta]Dyad[{4, -NP}][\[CapitalTheta]Dyad[{3, -NP}][PsiCDe0Dyad[]]]\
\>", "Output",
