Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", 
    OverscriptBox["\[Thorn]", "."]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"d\[Thorn]", "[", "arg_", "]"}], "]"}], ":=", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\!\(\*OverscriptBox[\(\[Thorn]\), \(.\)]\)\>\"", ",", "\"\<[\>\"",
         ",", "arg", ",", "\"\<]\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d\[Thorn]", "/:", 
     RowBox[{"d\[Thorn]", "[", "0", "]"}], ":=", "0"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d\[Thorn]", "/:", 
     RowBox[{"d\[Thorn]", "[", 
      RowBox[{"a_", " ", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"d\[Thorn]", "[", "a", "]"}], " ", 
       RowBox[{"(", "b", ")"}]}], "+", 
      RowBox[{"a", " ", 
       RowBox[{"(", 
        RowBox[{"d\[Thorn]", "[", "b", "]"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d\[Thorn]", "/:", 
     RowBox[{"d\[Thorn]", "[", 
      RowBox[{"a_", "+", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"d\[Thorn]", "[", "a", "]"}], "+", 
      RowBox[{"d\[Thorn]", "[", "b", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GHPWeightOf", "[", 
      RowBox[{"d\[Thorn]", "[", "x_", "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"GHPWeightOf", "[", "x", "]"}], "+", 
      RowBox[{"GHPWeightOf", "[", 
       RowBox[{"lNP", "[", "a", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", 
     RowBox[{
      OverscriptBox["\[Thorn]", "."], "'"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"d\[Thorn]p", "[", "arg_", "]"}], "]"}], ":=", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
