Notebook[{

Cell[CellGroupData[{
Cell["2-Spinors in GR: Curvature equations ", "Title",
 CellChangeTimes->{{3.947328917141201*^9, 3.947328937905325*^9}, 
   3.978717922266498*^9, {3.9870014122972403`*^9, 3.987001415718391*^9}, {
   3.987005639662809*^9, 
   3.987005646582273*^9}},ExpressionUUID->"3e7a305a-2d30-47fd-a3e5-\
e4c7a9bf1168"],

Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{3.947577994492762*^9, 3.947577995234399*^9}},
 CellLabel->
  "In[273]:=",ExpressionUUID->"02c1bf6b-e284-4df3-a53c-b55c3f0037cb"],

Cell[TextData[{
 StyleBox["Description:",
  FontWeight->"Bold"],
 " Example notebook associated to the notes [XXXX] on 2-spinors in GR. We \
derive non-perturbative curavture equations for the Weyl scalars, starting \
from the spinor equations. Then we derive the Teukolsky equations and their \
sources.\n",
 StyleBox["Author: ",
  FontWeight->"Bold"],
 "David Pere\[NTilde]iguez, ",
 StyleBox["dpereni1@jhu.edu",
  FontFamily->"Courier New",
  FontWeight->"Regular"],
 StyleBox["\nWeb: ",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.987005361903241*^9, 3.9870054512018547`*^9}, {
  3.9870055152377567`*^9, 
  3.987005534360985*^9}},ExpressionUUID->"7fdbc2cb-507f-4dc9-accf-\
4296c9988012"],

