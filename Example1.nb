      ",", "Deriv$SC$Rep$\[Eth]$\[Rho]", ",", "Deriv$SC$Rep$\[Eth]p$\[Rho]p", 
      ",", "Deriv$SC$Rep$\[Thorn]$\[Tau]", ",", "Deriv$SC$Rep$\[Eth]$\[Tau]", 
      ",", "Deriv$SC$Rep$\[Eth]p$\[Tau]", ",", 
      "Deriv$SC$Rep$\[Thorn]p$\[Tau]p", ",", "Deriv$SC$Rep$\[Eth]$\[Tau]p", 
      ",", "Deriv$SC$Rep$\[Eth]p$\[Tau]p"}], "}"}], "]"}]}], "//", 
  "Simplify"}]], "Input",
